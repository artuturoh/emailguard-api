# Server configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# RapidAPI Security
# When set, the API will strictly enforce that incoming requests include
# the 'X-RapidAPI-Proxy-Secret' header matching this value.
# Leave empty or comment out during local development/testing.
RAPIDAPI_PROXY_SECRET=your_rapidapi_proxy_secret_here

# DNS Configuration
DNS_TIMEOUT_MS=800
